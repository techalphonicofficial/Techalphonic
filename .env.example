# BACKEND_URL and SITE_URL are required: build and start fail with a clear error when they are missing.

# Where the Next server reaches Laravel (server-side only). In production this can be an internal address.
BACKEND_URL=http://127.0.0.1:8000

# Origins Laravel puts into absolute URLs (APP_URL and the BACKEND_URL host). They are rewritten to SITE_URL
# so links, media and canonicals all point at the public site. Comma separated.
BACKEND_PUBLIC_ORIGINS=http://127.0.0.1:8000

# Public origin of this Next.js site (no trailing slash). In production: https://www.example.com
SITE_URL=http://localhost:3000

# Must match FRONTEND_API_KEY in Laravel's .env (skips the site API rate limit for the Next server).
FRONTEND_API_KEY=

# Must match FRONTEND_REVALIDATE_SECRET in Laravel's .env (admin saves refresh cached pages instantly).
REVALIDATE_SECRET=

# Must match ADMIN_PATH in Laravel's .env.
ADMIN_PATH=admin
